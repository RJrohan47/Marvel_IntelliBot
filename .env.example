# example .env file for Marvel chatbot
GEMINI_API_KEY='Your Gemini API key here'
GEMINI_CHAT_MODEL='gemini-3.6-flash'
GROQ_API_KEY='Optional Groq API key for Gemini fallback'
GROQ_CHAT_MODEL='openai/gpt-oss-20b'

WEATHERSTACK_API_KEY='Your Weather Stack API key here'
LANGSMITH_TRACING='Mark it True if you want to enable tracing using Langsmith'
LANGSMITH_API_KEY='Your LAngSmith API key here'
LANGSMITH_ENDPOINT='Langsmith endpoint here'
LANGSMITH_PROJECT='Write your Project Name'
